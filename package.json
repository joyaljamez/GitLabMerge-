{
  "name": "gitmerge-vscode",
  "displayName": "Git Merge — GitLab & GitHub",
  "description": "Create GitLab merge requests and GitHub pull requests from VS Code",
  "publisher": "JoyalJames",
  "version": "4.0.7",
  "icon": "src/assets/icon.png",
  "repository": "https://github.com/joyaljamez/GitLabMerge-.git",
  "engines": {
    "vscode": "^1.61.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:gitmerge"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "gitmerge": [
        {
          "type": "webview",
          "id": "gitmerge",
          "name": "Create Merge Request"
        },
        {
          "type": "webview",
          "id": "gitmerge.merge",
          "name": "My Merge Requests"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitmerge",
          "title": "GitMerge",
          "icon": "src/assets/gitmerge.svg"
        }
      ]
    },
    "configuration": {
      "title": "GitMerge",
      "properties": {
        "gitmerge.platform": {
          "type": "string",
          "enum": [
            "auto",
            "gitlab",
            "github"
          ],
          "default": "auto",
          "description": "Hosting platform. Use auto to detect from the git remote URL."
        },
        "gitmerge.instanceUrl": {
          "type": "string",
          "default": "",
          "description": "Optional custom base URL (self-managed GitLab or GitHub Enterprise)."
        },
        "gitmerge.token": {
          "type": "string",
          "default": "",
          "description": "Personal access token for GitLab or GitHub"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "gitmerge.repository",
          "when": "view == gitmerge"
        },
        {
          "command": "gitmerge.merge.requests",
          "when": "view == gitmerge"
        },
        {
          "command": "gitmerge.showInfo",
          "when": "view == gitmerge",
          "group": "navigation"
        },
        {
          "command": "gitmerge.clearForm",
          "when": "view == gitmerge",
          "group": "navigation"
        },
        {
          "command": "gitmerge.refresh",
          "when": "view == gitmerge",
          "group": "navigation"
        },
        {
          "command": "gitmerge.showInfo",
          "when": "view == gitmerge.merge",
          "group": "navigation"
        },
        {
          "command": "gitmerge.refreshMrs",
          "when": "view == gitmerge.merge",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "gitmerge.repository",
        "title": "Repository"
      },
      {
        "command": "gitmerge.merge.requests",
        "title": "Merge Requests"
      },
      {
        "command": "gitmerge.showInfo",
        "title": "Setup Info",
        "icon": "$(info)"
      },
      {
        "command": "gitmerge.clearForm",
        "title": "Clear Form",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitmerge.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitmerge.refreshMrs",
        "title": "Refresh Merge Requests",
        "icon": "$(refresh)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run copy-toolkit && npm run package",
    "copy-toolkit": "cp node_modules/@vscode/webview-ui-toolkit/dist/toolkit.js src/assets/toolkit.js",
    "compile": "webpack",
    "watch": "NODE_OPTIONS=--openssl-legacy-provider webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "test-compile": "tsc -p ./",
    "test-watch": "tsc -watch -p ./",
    "pretest": "npm run test-compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^7.1.3",
    "@types/mocha": "^8.2.2",
    "@types/node": "14.x",
    "@types/vscode": "^1.61.0",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "eslint": "^7.27.0",
    "glob": "^7.1.7",
    "iconv-lite": "^0.6.3",
    "mocha": "^8.4.0",
    "ts-loader": "^9.2.2",
    "typescript": "^4.3.2",
    "vscode-test": "^1.5.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "axios": "^1.8.4"
  }
}
